  <!-- SCRIPT LOGICA Y BASE DE DATOS LOCALSTORAGE -->
  <script>
    // BASE DE DATOS Y USUARIOS
    const USERS_DB = {
      'admin': { pass: '1234', role: 'admin' },
      'vendedor': { pass: '1234', role: 'vendedor' }
    };

    let db = {
      productos: JSON.parse(localStorage.getItem('dm_productos')) || [],
      clientes: JSON.parse(localStorage.getItem('dm_clientes')) || [
        { id: 'CLI-001', nombre: 'Cliente General / Contado', telefono: 'N/A', cedula: 'N/A', limite: 0, deuda: 0 }
      ],
      ventas: JSON.parse(localStorage.getItem('dm_ventas')) || [],
      movimientos: JSON.parse(localStorage.getItem('dm_movimientos')) || [],
      finanzas: JSON.parse(localStorage.getItem('dm_finanzas')) || [],
      abonos: JSON.parse(localStorage.getItem('dm_abonos')) || [],
      fondoCaja: parseFloat(localStorage.getItem('dm_fondoCaja')) || 0
    };

    let carrito = [];
    let clienteSeleccionadoHistorial = null;
    let chartVG = null, chartMP = null;

    // AUTENTICACIÓN
    function autenticarUsuario(e) {
      e.preventDefault();
      const u = document.getElementById('login-user').value.trim().toLowerCase();
      const p = document.getElementById('login-pass').value.trim();
      const errEl = document.getElementById('login-error');

      if (USERS_DB[u] && USERS_DB[u].pass === p) {
        errEl.style.display = 'none';
        sessionStorage.setItem('authenticatedUser', u);
        sessionStorage.setItem('userRole', USERS_DB[u].role);
        aplicarSesion();
      } else {
        errEl.style.display = 'block';
      }
    }

    function aplicarSesion() {
      const user = sessionStorage.getItem('authenticatedUser');
      const role = sessionStorage.getItem('userRole');

      if (user) {
        document.getElementById('login-overlay').style.display = 'none';
        document.getElementById('main-app-content').style.display = 'block';

        document.querySelectorAll('.admin-only').forEach(el => {
          el.style.display = (role === 'admin') ? 'inline-flex' : 'none';
        });

        inicializarSistema();
      } else {
        document.getElementById('login-overlay').style.display = 'flex';
        document.getElementById('main-app-content').style.display = 'none';
      }
    }

    function cerrarSesion() {
      sessionStorage.clear();
      location.reload();
    }

    function guardarDB() {
      localStorage.setItem('dm_productos', JSON.stringify(db.productos));
      localStorage.setItem('dm_clientes', JSON.stringify(db.clientes));
      localStorage.setItem('dm_ventas', JSON.stringify(db.ventas));
      localStorage.setItem('dm_movimientos', JSON.stringify(db.movimientos));
      localStorage.setItem('dm_finanzas', JSON.stringify(db.finanzas));
      localStorage.setItem('dm_abonos', JSON.stringify(db.abonos));
      localStorage.setItem('dm_fondoCaja', db.fondoCaja.toString());
    }

    // NAVEGACIÓN
    function switchTab(tabId) {
      document.querySelectorAll('.tab-content').forEach(t => t.classList.remove('active'));
      document.querySelectorAll('.nav-btn').forEach(b => b.classList.remove('active'));
      document.getElementById(tabId).classList.add('active');
      event.currentTarget.classList.add('active');

      if (tabId === 'pos') renderPOS();
      if (tabId === 'clientes') renderClientes();
      if (tabId === 'inventario') renderInventario();
      if (tabId === 'movimientos') renderMovimientos();
      if (tabId === 'finanzas') renderFinanzas();
    }

    // UTILIDADES DE FORMATO DE MONEDA
    function parseCurrency(str) {
      if (!str) return 0;
      return parseFloat(str.toString().replace(/[^0-9.-]+/g, '')) || 0;
    }

    function formatDOP(num) {
      return 'DOP$ ' + (num || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }

    function formatInputCurrency(input) {
      let val = input.value.replace(/[^0-9.]/g, '');
      const parts = val.split('.');
      if (parts.length > 2) val = parts[0] + '.' + parts.slice(1).join('');
      if (parts[0]) parts[0] = parseInt(parts[0], 10).toLocaleString('en-US');
      input.value = parts.join('.');
    }

    // SUBTIPOS Y TALLAS POR CATEGORÍA
    const OPCIONES_CAT = {
      ROP: {
        subtipos: { 'BLU': 'Blusa', 'CAM': 'Camisa', 'PAN': 'Pantalón', 'VEST': 'Vestido', 'SHORT': 'Short' },
        tallas: ['XS', 'S', 'M', 'L', 'XL', '2XL']
      },
      CAL: {
        subtipos: { 'TEN': 'Tenis', 'SAN': 'Sandalias', 'ZAP': 'Zapato Formal', 'TAC': 'Tacones' },
        tallas: ['35', '36', '37', '38', '39', '40', '41', '42']
      },
      PER: {
        subtipos: { 'PERF': 'Perfume', 'CREM': 'Crema Corporal', 'SPLASH': 'Body Splash' },
        tallas: ['50ml', '100ml', '200ml', 'Estándar']
      }
    };

    function alCambiarCategoria() {
      const cat = document.getElementById('prod-categoria').value;
      const subSelect = document.getElementById('prod-subtipo');
      const tallaSelect = document.getElementById('prod-talla');

      subSelect.innerHTML = '';
      tallaSelect.innerHTML = '';

      Object.entries(OPCIONES_CAT[cat].subtipos).forEach(([key, val]) => {
        subSelect.innerHTML += `<option value="${key}">${val}</option>`;
      });

      OPCIONES_CAT[cat].tallas.forEach(t => {
        tallaSelect.innerHTML += `<option value="${t}">${t}</option>`;
      });

      generarCodigoAutomatico();
    }

    function generarCodigoAutomatico() {
      const cat = document.getElementById('prod-categoria').value;
      const sub = document.getElementById('prod-subtipo').value || 'GEN';
      const gen = document.getElementById('prod-genero').value;
      const talla = document.getElementById('prod-talla').value;

      const correlativo = String(db.productos.length + 1).padStart(3, '0');
      document.getElementById('prod-codigo').value = `${cat}-${sub}-${gen}-${correlativo}-${talla}`;
    }

    // GUARDAR PRODUCTO
    function guardarProducto(e) {
      e.preventDefault();
      const prod = {
        codigo: document.getElementById('prod-codigo').value.trim(),
        nombre: document.getElementById('prod-nombre').value.trim(),
        categoria: document.getElementById('prod-categoria').value,
        subtipo: document.getElementById('prod-subtipo').value,
        genero: document.getElementById('prod-genero').value,
        talla: document.getElementById('prod-talla').value,
        color: document.getElementById('prod-color').value.trim(),
        precioCompra: parseCurrency(document.getElementById('prod-precio-compra').value),
        precioVenta: parseCurrency(document.getElementById('prod-precio-venta').value),
        stock: parseInt(document.getElementById('prod-stock').value) || 0
      };

      db.productos.push(prod);
      guardarDB();
      alert('✅ Producto registrado exitosamente');
      document.getElementById('form-producto').reset();
      alCambiarCategoria();
      renderInventario();
    }

    function renderInventario() {
      const tbody = document.getElementById('inventario-table-body');
      const search = document.getElementById('inv-search').value.toLowerCase();
      const filterCat = document.getElementById('inv-filter-cat').value;

      tbody.innerHTML = '';

      const filtrados = db.productos.filter(p => {
        const matchSearch = p.nombre.toLowerCase().includes(search) || p.codigo.toLowerCase().includes(search);
        const matchCat = filterCat === '' || p.categoria === filterCat;
        return matchSearch && matchCat;
      });

      filtrados.forEach((p, index) => {
        tbody.innerHTML += `
          <tr>
            <td><strong>${p.codigo}</strong></td>
            <td>${p.nombre}</td>
            <td>${p.categoria}</td>
            <td>${p.talla} / ${p.color || '-'}</td>
            <td>${formatDOP(p.precioCompra)}</td>
            <td>${formatDOP(p.precioVenta)}</td>
            <td><span class="badge ${p.stock <= 2 ? 'badge-danger' : 'badge-success'}">${p.stock} uds</span></td>
            <td>
              <button class="btn btn-danger" style="padding:2px 6px; font-size:0.75rem;" onclick="eliminarProducto(${index})">🗑️</button>
            </td>
          </tr>
        `;
      });
    }

    function eliminarProducto(index) {
      if (confirm('¿Seguro que desea eliminar este producto?')) {
        db.productos.splice(index, 1);
        guardarDB();
        renderInventario();
      }
    }

    // POS - VENTAS
    let posCatFiltro = 'TODAS';

    function filtrarCategoriaPOS(cat, btn) {
      posCatFiltro = cat;
      document.querySelectorAll('.cat-filter-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      renderPOS();
    }

    function filtrarPOS() { renderPOS(); }

    function renderPOS() {
      const container = document.getElementById('pos-products');
      const search = document.getElementById('pos-search').value.toLowerCase();
      container.innerHTML = '';

      const prods = db.productos.filter(p => {
        const matchCat = posCatFiltro === 'TODAS' || p.categoria === posCatFiltro;
        const matchSearch = p.nombre.toLowerCase().includes(search) || p.codigo.toLowerCase().includes(search);
        return matchCat && matchSearch;
      });

      prods.forEach(p => {
        const outStock = p.stock <= 0;
        container.innerHTML += `
          <div class="product-card ${outStock ? 'out-of-stock' : ''}" onclick="${outStock ? '' : `agregarAlCarrito('${p.codigo}')`}">
            <h4>${p.nombre}</h4>
            <div style="font-size:0.75rem; color:#888;">${p.talla}</div>
            <div class="price">${formatDOP(p.precioVenta)}</div>
            <div class="stock">Stock: ${p.stock}</div>
          </div>
        `;
      });

      renderSelectClientesPOS();
    }

    function agregarAlCarrito(codigo) {
      const prod = db.productos.find(p => p.codigo === codigo);
      if (!prod || prod.stock <= 0) return;

      const item = carrito.find(c => c.codigo === codigo);
      if (item) {
        if (item.cantidad < prod.stock) item.cantidad++;
        else alert('⚠️ Límite de stock alcanzado.');
      } else {
        carrito.push({ codigo: prod.codigo, nombre: prod.nombre, precio: prod.precioVenta, precioCompra: prod.precioCompra, cantidad: 1 });
      }
      renderCarrito();
    }

    function renderCarrito() {
      const tbody = document.getElementById('cart-table-body');
      tbody.innerHTML = '';

      carrito.forEach((item, index) => {
        tbody.innerHTML += `
          <tr>
            <td>${item.nombre}</td>
            <td style="text-align:center;">
              <button class="btn-qty" onclick="modificarCantidadCarrito(${index}, -1)">-</button>
              ${item.cantidad}
              <button class="btn-qty" onclick="modificarCantidadCarrito(${index}, 1)">+</button>
            </td>
            <td style="text-align:right;">${formatDOP(item.precio * item.cantidad)}</td>
            <td><button class="btn btn-danger" style="padding:1px 5px;" onclick="quitarDelCarrito(${index})">x</button></td>
          </tr>
        `;
      });

      calcularTotalCarrito();
    }

    function modificarCantidadCarrito(index, delta) {
      const item = carrito[index];
      const prod = db.productos.find(p => p.codigo === item.codigo);
      if (delta > 0 && item.cantidad >= prod.stock) {
        alert('⚠️ No hay más stock disponible.');
        return;
      }
      item.cantidad += delta;
      if (item.cantidad <= 0) carrito.splice(index, 1);
      renderCarrito();
    }

    function quitarDelCarrito(index) {
      carrito.splice(index, 1);
      renderCarrito();
    }

    function calcularTotalCarrito() {
      const subtotal = carrito.reduce((acc, i) => acc + (i.precio * i.cantidad), 0);
      const descTipo = document.getElementById('cart-discount-type').value;
      const descInput = parseCurrency(document.getElementById('cart-discount').value);

      let descuento = descTipo === 'FIXED' ? descInput : subtotal * (descInput / 100);
      if (descuento > subtotal) descuento = subtotal;

      const base = subtotal - descuento;
      const tieneITBIS = document.getElementById('cart-itbis-toggle').checked;
      const itbis = tieneITBIS ? base * 0.18 : 0;
      const total = base + itbis;

      document.getElementById('cart-subtotal').innerText = formatDOP(subtotal);
      document.getElementById('cart-itbis-amount').innerText = formatDOP(itbis);
      document.getElementById('cart-total').innerText = formatDOP(total);

      calcularDevuelta();
    }

    function evaluarMetodoPago() {
      const met = document.getElementById('payment-method').value;
      document.getElementById('seccion-pago-mixto').style.display = met === 'MIXTO' ? 'block' : 'none';
      document.getElementById('seccion-credito-detalle').style.display = met === 'MIXTO' ? 'none' : 'block';
    }

    function calcularDevuelta() {
      const total = parseCurrency(document.getElementById('cart-total').innerText);
      const recibido = parseCurrency(document.getElementById('monto-recibido').value);
      const devuelta = recibido - total;

      document.getElementById('cart-change').innerText = formatDOP(devuelta > 0 ? devuelta : 0);
    }

    function procesarVenta() {
      if (carrito.length === 0) return alert('⚠️ El carrito está vacío.');

      const total = parseCurrency(document.getElementById('cart-total').innerText);
      const metodo = document.getElementById('payment-method').value;
      const clienteId = document.getElementById('pos-cliente').value;
      const cliente = db.clientes.find(c => c.id === clienteId);

      if (metodo === 'Fiado') {
        if (clienteId === 'CLI-001') return alert('⚠️ Debe seleccionar un cliente registrado para vender a crédito.');
        if ((cliente.deuda + total) > cliente.limite) {
          return alert(`❌ La venta supera el límite de crédito del cliente. Disponible: ${formatDOP(cliente.limite - cliente.deuda)}`);
        }
        cliente.deuda += total;
      }

      // Descontar inventario
      carrito.forEach(i => {
        const p = db.productos.find(prod => prod.codigo === i.codigo);
        if (p) p.stock -= i.cantidad;
      });

      const venta = {
        id: 'VEN-' + Date.now(),
        fecha: new Date().toLocaleString(),
        cliente: cliente.nombre,
        items: [...carrito],
        total: total,
        metodo: metodo
      };

      db.ventas.push(venta);
      guardarDB();

      imprimirTicketVenta(venta);

      carrito = [];
      document.getElementById('monto-recibido').value = '';
      renderCarrito();
      renderPOS();
      alert('✅ Venta completada con éxito.');
    }

    function imprimirTicketVenta(v) {
      const t = document.getElementById('ticket-print');
      t.innerHTML = `
        <h2>DE MARY EXCLUSIVIDADES</h2>
        <p>Fecha: ${v.fecha}</p>
        <p>Cliente: ${v.cliente}</p>
        <div class="divider"></div>
        <table>
          ${v.items.map(i => `<tr><td>${i.nombre} x${i.cantidad}</td><td class="text-right">${formatDOP(i.precio * i.cantidad)}</td></tr>`).join('')}
        </table>
        <div class="divider"></div>
        <p class="text-right"><strong>TOTAL: ${formatDOP(v.total)}</strong></p>
        <p style="text-align:center; margin-top:10px;">¡Gracias por su compra!</p>
      `;

      document.body.classList.add('printing-ticket');
      window.print();
      document.body.classList.remove('printing-ticket');
    }

    // CLIENTES
    function renderSelectClientesPOS() {
      const select = document.getElementById('pos-cliente');
      select.innerHTML = '';
      db.clientes.forEach(c => {
        select.innerHTML += `<option value="${c.id}">${c.nombre} ${c.deuda > 0 ? `(Deuda: ${formatDOP(c.deuda)})` : ''}</option>`;
      });
      alCambiarClientePOS();
    }

    function alCambiarClientePOS() {
      const id = document.getElementById('pos-cliente').value;
      const c = db.clientes.find(cli => cli.id === id);
      const info = document.getElementById('pos-cliente-info');
      if (c && c.limite > 0) {
        info.innerText = `Disponible Fiado: ${formatDOP(c.limite - c.deuda)}`;
      } else {
        info.innerText = '';
      }
    }

    function guardarCliente(e) {
      e.preventDefault();
      const cli = {
        id: document.getElementById('cli-id').value || 'CLI-' + Date.now(),
        nombre: document.getElementById('cli-nombre').value.trim(),
        telefono: document.getElementById('cli-telefono').value.trim(),
        cedula: document.getElementById('cli-cedula').value.trim(),
        limite: parseCurrency(document.getElementById('cli-limite').value),
        deuda: 0
      };

      const existingIndex = db.clientes.findIndex(c => c.id === cli.id);
      if (existingIndex >= 0) {
        cli.deuda = db.clientes[existingIndex].deuda;
        db.clientes[existingIndex] = cli;
      } else {
        db.clientes.push(cli);
      }

      guardarDB();
      alert('✅ Cliente guardado con éxito');
      resetFormCliente();
      renderClientes();
    }

    function resetFormCliente() {
      document.getElementById('form-cliente').reset();
      document.getElementById('cli-id').value = '';
      document.getElementById('btn-cancelar-cli').style.display = 'none';
    }

    function renderClientes() {
      const tbody = document.getElementById('clientes-table-body');
      const search = document.getElementById('cli-search').value.toLowerCase();
      tbody.innerHTML = '';

      db.clientes.filter(c => c.nombre.toLowerCase().includes(search)).forEach(c => {
        tbody.innerHTML += `
          <tr>
            <td><strong>${c.nombre}</strong></td>
            <td>${c.telefono}</td>
            <td>${c.cedula}</td>
            <td>${formatDOP(c.limite)}</td>
            <td style="color:${c.deuda > 0 ? 'var(--danger)' : 'green'}; font-weight:bold;">${formatDOP(c.deuda)}</td>
            <td>${formatDOP(c.limite - c.deuda)}</td>
            <td>
              <button class="btn btn-warning" style="padding:2px 6px; font-size:0.75rem;" onclick="abrirHistorialCliente('${c.id}')">📜 Expediente</button>
            </td>
          </tr>
        `;
      });
    }

    function abrirHistorialCliente(id) {
      clienteSeleccionadoHistorial = db.clientes.find(c => c.id === id);
      document.getElementById('historial-cli-titulo').innerText = `Expediente: ${clienteSeleccionadoHistorial.nombre}`;
      document.getElementById('historial-cli-resumen').innerHTML = `
        <strong>Límite:</strong> ${formatDOP(clienteSeleccionadoHistorial.limite)} | 
        <strong style="color:var(--danger)">Deuda Actual:</strong> ${formatDOP(clienteSeleccionadoHistorial.deuda)}
      `;

      const ventasBody = document.getElementById('historial-ventas-body');
      ventasBody.innerHTML = '';
      db.ventas.filter(v => v.cliente === clienteSeleccionadoHistorial.nombre).forEach(v => {
        ventasBody.innerHTML += `<tr><td>${v.fecha}</td><td>${v.metodo}</td><td>${formatDOP(v.total)}</td></tr>`;
      });

      document.getElementById('modal-historial-cliente').style.display = 'flex';
    }

    function cerrarModalHistorial() {
      document.getElementById('modal-historial-cliente').style.display = 'none';
    }

    function procesarAbonoCliente() {
      const monto = parseCurrency(document.getElementById('abono-monto').value);
      if (monto <= 0) return alert('⚠️ Ingrese un monto válido.');

      if (monto > clienteSeleccionadoHistorial.deuda) {
        return alert('⚠️ El abono es superior a la deuda actual.');
      }

      clienteSeleccionadoHistorial.deuda -= monto;
      db.abonos.push({ fecha: new Date().toLocaleString(), cliente: clienteSeleccionadoHistorial.nombre, monto: monto });
      guardarDB();

      alert('✅ Abono registrado correctamente.');
      document.getElementById('abono-monto').value = '';
      abrirHistorialCliente(clienteSeleccionadoHistorial.id);
      renderClientes();
    }

    // MOVIMIENTOS
    function renderMovimientos() {
      const select = document.getElementById('mov-producto');
      select.innerHTML = '';
      db.productos.forEach(p => select.innerHTML += `<option value="${p.codigo}">${p.nombre} (${p.codigo})</option>`);

      const tbody = document.getElementById('movimientos-table-body');
      tbody.innerHTML = '';
      db.movimientos.forEach(m => {
        tbody.innerHTML += `<tr><td>${m.fecha}</td><td>${m.producto}</td><td>${m.tipo}</td><td>${m.cantidad}</td><td>${m.motivo}</td></tr>`;
      });
    }

    function guardarMovimiento(e) {
      e.preventDefault();
      const cod = document.getElementById('mov-producto').value;
      const tipo = document.getElementById('mov-tipo').value;
      const cant = parseInt(document.getElementById('mov-cantidad').value);
      const mot = document.getElementById('mov-motivo').value;

      const p = db.productos.find(prod => prod.codigo === cod);
      if (tipo === 'Entrada') p.stock += cant;
      else p.stock -= cant;

      db.movimientos.push({ fecha: new Date().toLocaleString(), producto: p.nombre, tipo, cantidad: cant, motivo: mot });
      guardarDB();
      alert('✅ Ajuste guardado.');
      document.getElementById('form-movimiento').reset();
      renderMovimientos();
    }

    // FINANZAS Y DASHBOARD
    function renderFinanzas() {
      const ventasTotales = db.ventas.reduce((a, b) => a + b.total, 0);
      const gastosTotales = db.finanzas.filter(f => f.tipo === 'Gasto').reduce((a, b) => a + b.monto, 0);

      // Ganancia real estimada
      let ganancia = 0;
      db.ventas.forEach(v => {
        v.items.forEach(i => {
          ganancia += (i.precio - (i.precioCompra || 0)) * i.cantidad;
        });
      });

      document.getElementById('kpi-ventas').innerText = formatDOP(ventasTotales);
      document.getElementById('kpi-gastos').innerText = formatDOP(gastosTotales);
      document.getElementById('kpi-ganancia-neta').innerText = formatDOP(ganancia - gastosTotales);

      const tbody = document.getElementById('finanzas-table-body');
      tbody.innerHTML = '';
      db.finanzas.forEach(f => {
        tbody.innerHTML += `<tr><td>${f.fecha}</td><td>${f.tipo}</td><td>${f.concepto}</td><td>${formatDOP(f.monto)}</td></tr>`;
      });

      renderGraficos(ventasTotales, gastosTotales);
    }

    function guardarFinanza(e) {
      e.preventDefault();
      db.finanzas.push({
        fecha: new Date().toLocaleString(),
        tipo: document.getElementById('fin-tipo').value,
        concepto: document.getElementById('fin-concepto').value.trim(),
        monto: parseCurrency(document.getElementById('fin-monto').value)
      });
      guardarDB();
      alert('✅ Transacción guardada.');
      document.getElementById('form-finanzas').reset();
      renderFinanzas();
    }

    function renderGraficos(ventas, gastos) {
      if (chartVG) chartVG.destroy();
      if (chartMP) chartMP.destroy();

      const ctx1 = document.getElementById('chartVentasGastos').getContext('2d');
      chartVG = new Chart(ctx1, {
        type: 'bar',
        data: {
          labels: ['Ventas Totales', 'Gastos Totales'],
          datasets: [{ data: [ventas, gastos], backgroundColor: ['#8e24aa', '#c62828'] }]
        },
        options: { plugins: { legend: { display: false } } }
      });

      const metodos = { Efectivo: 0, Tarjeta: 0, Transferencia: 0, Fiado: 0 };
      db.ventas.forEach(v => { if (metodos[v.metodo] !== undefined) metodos[v.metodo] += v.total; });

      const ctx2 = document.getElementById('chartMetodosPago').getContext('2d');
      chartMP = new Chart(ctx2, {
        type: 'doughnut',
        data: {
          labels: Object.keys(metodos),
          datasets: [{ data: Object.values(metodos), backgroundColor: ['#2e7d32', '#0288d1', '#f57c00', '#c62828'] }]
        }
      });
    }

    // CONTROL DE CAJA
    function abrirModalCaja() {
      document.getElementById('caja-monto-inicial').value = db.fondoCaja;
      const ventasEfectivo = db.ventas.filter(v => v.metodo === 'Efectivo').reduce((a, b) => a + b.total, 0);

      document.getElementById('arq-inicial').innerText = formatDOP(db.fondoCaja);
      document.getElementById('arq-efectivo').innerText = formatDOP(ventasEfectivo);
      document.getElementById('arq-esperado').innerText = formatDOP(db.fondoCaja + ventasEfectivo);

      document.getElementById('modal-caja').style.display = 'flex';
    }

    function cerrarModalCaja() { document.getElementById('modal-caja').style.display = 'none'; }

    function guardarFondoInicial() {
      db.fondoCaja = parseCurrency(document.getElementById('caja-monto-inicial').value);
      guardarDB();
      alert('✅ Fondo guardado.');
      abrirModalCaja();
    }

    // IMPRESIÓN Y BACKUPS JSON
    function imprimirInventarioPDF() {
      document.body.classList.add('printing-inventario');
      window.print();
      document.body.classList.remove('printing-inventario');
    }

    function descargarBackupJSON() {
      const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(db));
      const downloadAnchor = document.createElement('a');
      downloadAnchor.setAttribute("href", dataStr);
      downloadAnchor.setAttribute("download", `backup_demary_${new Date().toISOString().slice(0,10)}.json`);
      document.body.appendChild(downloadAnchor);
      downloadAnchor.click();
      downloadAnchor.remove();
    }

    function restaurarBackupJSON(event) {
      const file = event.target.files[0];
      if (!file) return;

      const reader = new FileReader();
      reader.onload = function(e) {
        try {
          db = JSON.parse(e.target.result);
          guardarDB();
          alert('✅ Datos restaurados con éxito.');
          location.reload();
        } catch (err) {
          alert('❌ El archivo seleccionado no es un respaldo válido.');
        }
      };
      reader.readAsText(file);
    }

    // INICIALIZACIÓN GENERICA
    function inicializarSistema() {
      alCambiarCategoria();
      renderPOS();
    }
    
  </script>
</body>
</html>
